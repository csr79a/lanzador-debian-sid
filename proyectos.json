{
  "carpeta_proyectos": "~/.local/share/lanzador-debian-sid/proyectos",
  "acciones": [
    {
      "seccion": "Base",
      "titulo": "Configurar Debian Sid",
      "descripcion": "Setup inicial del sistema.",
      "repo": "https://github.com/csr79a/debian-sid-setup.git",
      "script": "setup/setup-debian-sid.sh"
    },
    {
      "seccion": "Base",
      "titulo": "Limpiar Debian Sid",
      "descripcion": "Revierte parte de la configuración base.",
      "repo": "https://github.com/csr79a/debian-sid-setup.git",
      "script": "cleanup/cleanup-debian-sid.sh",
      "peligroso": true
    },
    {
      "seccion": "Gaming",
      "titulo": "Instalar gaming",
      "descripcion": "Steam, ProtonPlus, Heroic, GameMode, MangoHud y ntsync.",
      "repo": "https://github.com/csr79a/setup-gaming-debian-sid.git",
      "script": "setup-gaming-debian-sid.sh"
    },
    {
      "seccion": "Gaming",
      "titulo": "Limpiar gaming",
      "descripcion": "Elimina lo instalado por el script de gaming.",
      "repo": "https://github.com/csr79a/setup-gaming-debian-sid.git",
      "script": "cleanup-gaming-debian-sid.sh",
      "peligroso": true
    },
    {
      "seccion": "Rendimiento",
      "titulo": "Instalar sched-ext",
      "descripcion": "Compila e instala los schedulers scx y sus herramientas.",
      "repo": "https://github.com/csr79a/sched-ext-debian.git",
      "script": "setup-sched-ext-debian.sh"
    },
    {
      "seccion": "Rendimiento",
      "titulo": "Instalar gestor de sched-ext (GUI)",
      "descripcion": "App gráfica para elegir el scheduler sin terminal. Necesita sched-ext ya instalado.",
      "repo": "https://github.com/csr79a/sched-ext-debian.git",
      "script": "scx-manager-gui/install-scx-manager-gui.sh"
    },
    {
      "seccion": "Rendimiento",
      "titulo": "Desinstalar sched-ext",
      "descripcion": "Quita sched-ext y sus herramientas.",
      "repo": "https://github.com/csr79a/sched-ext-debian.git",
      "script": "uninstall-sched-ext-debian.sh",
      "peligroso": true
    },
    {
      "seccion": "Gráficos NVIDIA",
      "titulo": "Instalar driver NVIDIA",
      "descripcion": "Driver nvidia-open, GRUB para KMS y comprobación de Secure Boot.",
      "repo": "https://github.com/csr79a/nvidia-debian-setup.git",
      "script": "setup-nvidia-debian-sid.sh"
    },
    {
      "seccion": "Hardware ASUS",
      "titulo": "Instalar asusctl / ROG Control",
      "descripcion": "Compila e instala asusctl y ROG Control.",
      "repo": "https://github.com/csr79a/asusctl-rogcontrol-debian.git",
      "script": "setup-asusctl-rogcontrol.sh"
    },
    {
      "seccion": "Hardware ASUS",
      "titulo": "Desinstalar asusctl / ROG Control",
      "descripcion": "Quita asusctl y ROG Control.",
      "repo": "https://github.com/csr79a/asusctl-rogcontrol-debian.git",
      "script": "uninstall-asusctl-rogcontrol.sh",
      "peligroso": true
    },
    {
      "seccion": "Terminal",
      "titulo": "Configurar terminal con Starship",
      "descripcion": "Versión para Debian.",
      "repo": "https://github.com/csr79a/terminal-starship-setup.git",
      "script": "setup-terminal-starship-debian.sh"
    }
  ]
}
